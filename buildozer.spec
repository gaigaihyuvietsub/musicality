[app]
title = Musicality
package.name = musicality
package.domain = org.musicality.app
source.dir = .
source.include_exts = py,png,jpg,kv,atlas,txt,md
version = 0.1.0
requirements = python3,kivy
orientation = portrait
fullscreen = 0
